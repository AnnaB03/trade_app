# --- Market data (quotes, chains, history) ---
# Production token = REAL-TIME quotes (needs a funded Tradier brokerage account).
# If only the sandbox token is set, data falls back to sandbox (~15 min delayed)
# and the UI banner shows "DATA: DELAYED".
TRADIER_TOKEN=your_tradier_production_token_here
TRADIER_TOKEN_SANDBOX=your_tradier_sandbox_token_here
# Optional override of the data base URL — normally leave unset; the app picks
# production automatically when TRADIER_TOKEN is present.
# TRADIER_BASE=https://api.tradier.com/v1

# --- Trading (order staging/preview) ---
# Order routes are HARD-LOCKED to the sandbox in this build (paper trading only).
# They use TRADIER_TRADE_TOKEN, falling back to TRADIER_TOKEN_SANDBOX.
# TRADIER_TRADE_TOKEN=your_tradier_sandbox_token_here
# TRADIER_ACCOUNT_ID=your_sandbox_account_id
# Unset by default = no per-trade max-loss cap, since order routes are paper
# money only in this build. Set a number here to re-enable the cap anyway.
# MAX_LOSS_PER_TRADE=500
# TRADIER_TRADE_BASE is the sandbox lock. Leave it unset. Pointing it anywhere
# other than the sandbox does NOT enable live trading — it disables order
# staging entirely ("Live trading is disabled in this build").
# TRADIER_TRADE_BASE=https://sandbox.tradier.com/v1

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional override for the Ideas model. Defaults to claude-sonnet-5-5 (see the
# note above the model call in app/api/suggestions/route.js for why).
# The Ideas tab loads once on open, then refreshes only on a manual click or
# at the schedule the desk rulebook calls for (8:30/9:45/2:30pm ET — the
# pre-market plan and the two prime trading windows; nothing during the
# 11:00-2:00 lunch chop, nothing while the market is fully closed). No
# interval polling. Each refresh is a billed API call.
# SUGGESTIONS_MODEL=claude-opus-5-5

# --- The daily plan (app/api/riskLib.js) — every rule stops NEW entries only;
# exits keep running, and the automatic ones clear at the next session. All in
# % of ACCOUNT_SIZE; 0 turns a rule off. Defaults shown.
# DAILY_LOSS_LIMIT_PCT=5     # down this much realized today = done for the day
# MAX_LOSS_STREAK=3          # this many closed losers in a row today = done
# DAILY_GOAL_PCT=1           # the goal; arms the giveback rule
# DAILY_PROFIT_LOCK_PCT=2    # up this much realized today = take the day
# DAY_GIVEBACK_PCT=50        # after the goal, giving back this share of the day's peak = done
# The manual kill switch is the Journal tab, or GET/POST /api/halt.

# Edge gate (app/api/edgeLib.js): a playbook whose last 20 closed trades lost
# money opens no new ones. The Journal tab's Edge card shows the verdicts.
# EDGE_GATE=false

# Tape gate (app/lib/tape.js): a same-day continuation is refused once the
# symbol has already used this % of its 14-day ATR today.
# ATR_USED_MAX_PCT=120

# Push notifications through ntfy.sh (app/api/notifyLib.js): fills, exits with
# P&L, halts, and the autopilot going dark. Pick a topic nobody would guess and
# subscribe to it in the ntfy app. Unset = no notifications.
# NTFY_TOPIC=cockpit-a8f3k2
# NTFY_URL=https://ntfy.sh
#
# Ideas and the trade journal are stored in a local SQLite database
# (./data/cockpit.db, gitignored) — see app/api/store.js. The old ideas.json /
# journal.json files are imported once on first start and renamed *.migrated.
# Needs a writable disk (local `next dev` / `next start`), not a read-only host.

# Powers ticker news in suggestions, auto event risk (earnings + macro calendar),
# analyst targets, and HV context. Requires FMP Starter plan or higher.
FMP_API_KEY=your_fmp_api_key_here

# LUNARCRUSH_TOKEN removed — the sentiment/Divergence board it powered was
# dropped (30-day price change vs. a single sentiment number wasn't a real
# day-trading signal). A social-attention-velocity read may replace it later.

# Account size the Ideas engine sizes for (dollars). The Ideas tab has an
# input that overrides this per browser; this is the server-side default when
# none is set there. Drives: which cheaper names get scanned, whether an
# option contract "fits" (hard cap 10% of account, comfortable 5%), and the
# share count per idea (1% risk to the stop, max 25% of account per position).
# ACCOUNT_SIZE=1000
