# ── Tradier Sandbox (for paper trading / practice) ─────────────────────
TRADIER_TOKEN_SANDBOX=paste_your_sandbox_access_token_here
# TRADIER_BASE=https://sandbox.tradier.com/v1  (default, uncomment to override)

# ── Tradier Production (for real-time live data) ──────────────────────
# Once you're ready to trade live, switch to production:
# 1. Create a PRODUCTION token in Dashboard → Settings → API Access
# 2. Use the production token below (requires a funded account for real-time data)
# TRADIER_TOKEN=paste_your_production_access_token_here
# TRADIER_BASE=https://api.tradier.com/v1
